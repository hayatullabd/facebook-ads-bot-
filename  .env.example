NODE_ENV=production
PORT=3000
APP_URL=https://api.youragency.com

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/fb_automation?retryWrites=true&w=majority
MONGODB_DB_NAME=fb_automation

JWT_SECRET=your_super_secret_key_min_32_chars_long_change_this
JWT_EXPIRE=86400

FACEBOOK_APP_ID=your_app_id
FACEBOOK_APP_SECRET=your_app_secret
FACEBOOK_BUSINESS_ACCOUNT_ID=your_bm_id
FACEBOOK_SYSTEM_USER_TOKEN=your_long_lived_token
FACEBOOK_API_VERSION=v18.0

TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_WEBHOOK_PATH=/api/webhook/telegram
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret

ADMIN_EMAIL=admin@youragency.com
LOG_LEVEL=info
